<section class="section callback">
    <div class="container callback__container">

        <h2 class="callback__title">
            ОСТАВЬТЕ ЗАЯВКУ И ПОЛУЧИТЕ ОПЕРАТИВНУЮ ПОМОЩЬ
        </h2>

        <form method="post" class="callback__form">

            <input type="text" name="nospam" value="" style="display:none" tabindex="-1" autocomplete="off">

            <div class="form__block">
                <input type="text" class="form__inp" name="name"
                       value="" placeholder="Имя" required>
                <img src="assets/components/rma/assets/images/new/form/name.svg"
                     alt="имя" class="form__img">
            </div>

            <div class="form__block">
                <input type="tel" class="form__inp" name="phone"
                       value="" placeholder="Телефон" required>
                <img src="assets/components/rma/assets/images/new/phone.svg"
                     alt="телефон" class="form__img">
            </div>

            <div class="form__block">
                <input type="email" class="form__inp" name="email"
                       value="" placeholder="E-mail" required>
                <img src="assets/components/rma/assets/images/new/form/email.svg"
                     alt="e-mail" class="form__img">
            </div>

            <div class="form__block-btn">

                <input type="submit"
                       name="order-submit"
                       value="отправить"
                       class="btn form__btn">

                <p class="callback__text">
                    Нажимая на кнопку отправить, <br>
                    я даю согласие на
                    <a href="assets/components/rma/assets/docs/soglasie-na-obrabotku-personalnih-dannih.pdf"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="text__link">
                        обработку данных
                    </a>
                </p>

            </div>

        </form>
    </div>
</section>
